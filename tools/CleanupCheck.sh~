    echo
    echo "=== Checking Trigger node $1 ==="
    problems=0

    # Check if local/run directory is empty
    get_run_dir_files $1
    if [[ $run_dir_files -ne 0 ]]; then
	problems=$((problems+1))
	echo -e "\e[31mPROBLEM\e[0m - Node $1 - $run_dir_files files found in $run_dir"
    fi

    # Check if trigger processes are still running
    proc_list=$( $ssh_cmd $1 ps -fu daq | grep PadmeTrig.exe | grep -v grep | grep -v bash | grep -v ssh | awk 'BEGIN{ORS=" "}{print $2}' )
    if [ ! -z "$proc_list" ]; then
	problems=$((problems+1))
