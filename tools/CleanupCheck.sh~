check_merger_node l1padme3
check_merger_node l1padme4

check_daq_node l0padme4
check_daq_node l0padme5

check_trigger_node l0padme1

if [[ $tot_problems -eq 0 ]]; then
    echo
    echo -e "\e[32mCleanupCheck OK\e[0m - All DAQ nodes are in a clean state: you can restart the run"
else
    echo
    echo -e "\e[31mCleanupCheck NOT OK\e[0m - A total of \e[31m$tot_problems problem(s)\e[0m were reported: please fix them using the Cleanup Procedure and \e[4mrun this script again\e[0m"
    echo -e "You can find the Cleanup Procedure at \e[36mhttps://github.com/PADME-Experiment/padme-fw/wiki/Clean-up-Procedure\e[0m"
fi
