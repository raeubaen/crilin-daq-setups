# Trigger configuration

# BTF trigger: 0000 0001
#trigger_mask 0x01

# Dual-timer trigger: 0000 1000
#trigger_mask 0x08

# BTF+cosmics: 0000 0011
#trigger_mask 0x03

# Cosmics: 0000 0010
#trigger_mask 0x02

# Random+Cosmics: 0100 0010
trigger_mask 0x42

# Mask 0x42 = 0100 0010: enable cosmics trigger and random trigger
#trigger_mask 0x42

# Mask 0xc1 = 1100 0001: enable BTF trigger, random trigger and correlated trigger
# N.B. in testbed BTF trigger is emulated with a dual-timer
#trigger_mask 0xc1

# Mask 0x81 = 1000 0001: enable BTF and correlated trigger
#trigger_mask 0x81

# Mask 0x83 = 1000 0011: enable BTF, cosmics, and correlated trigger
#trigger_mask 0x83

# Mask 0x0A = 0000 1010: enable dual-timer and cosmics
#trigger_mask 0x0A

# Handle CPU (bit 4) and Timepix (bit 2) busy signals
#busy_mask              0x14
busy_mask              0x10

# Get all BTF triggers, autopass 1 over 50 events
#trig0_scale_global 1
#trig0_scale_autopass 50

# Get all cosmics triggers, no autopass
#trig1_scale_global 1
#trig1_scale_autopass 0

# Get all dual-timer triggers, no need to autopass
#trig3_scale_global 1
#trig3_scale_autopass 0

# Downscale random trigger(2kHz) to 50Hz, no autopass
#trig6_scale_global 40
trig6_scale_global 40
trig6_scale_autopass 0

# Downscale correlated trigger to 1 over 50, always autopass
#trig7_scale_global 50
#trig7_scale_autopass 1

# Set correlated trigger delay to 900us
correlated_trigger_delay 900
# Timepix settings
timepix_shutter_delay 0x02
# 100(0x64) x 100ns = 10us
timepix_shutter_width 0x64

# No timepix-related shifts to trigger timing
trigger0_delay 0x00

# Use testbed trigger board
trigger_addr 192.168.60.101
trigger_port 7

daq_loop_delay 1000
debug_scale 100
